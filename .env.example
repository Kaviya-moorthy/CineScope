# Copy this file to ".env" and set ONE of the two values below, then restart "npm run dev".
# CineScope needs a TMDB credential: it shows real movie data only, with no sample mode.
#
# SECURITY: VITE_ variables are bundled into the browser code. A TMDB key used here is
# visible to anyone who opens your site. Never reuse a private key, and never commit .env.

# TMDB "API Key" (v3 auth)
VITE_TMDB_API_KEY="cdab93aa0b482c219202777a55c6cee8"

# Optional: TMDB "API Read Access Token" (v4 bearer). Takes priority if set.
